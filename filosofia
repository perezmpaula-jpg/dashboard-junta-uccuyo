/* ── API KEY ── */
function saveKey(){
  var k = document.getElementById('api-key-input').value.trim();
  if(!k.startsWith('sk-ant-')){ alert('La API key debe comenzar con sk-ant-'); return; }
  localStorage.setItem('ucc_key', k);
  document.getElementById('api-banner').style.display = 'none';
  fetchAI();
}
function getKey(){ return localStorage.getItem('ucc_key') || ''; }

/* ── ANÁLISIS IA ── */
async function fetchAI(){
  var zone = document.getElementById('ai-zone');
  var key  = getKey();
  if(!key){
    zone.innerHTML = '<div class="ldr" style="background:#fff3e0;border-color:#C8A04A;"><i class="ti ti-key" style="font-size:15px;color:#C8A04A;margin-right:6px"></i>Ingresá tu API key en el banner superior para activar el análisis de IA.</div>';
    return;
  }
  zone.innerHTML = '<div class="ldr"><div class="sp"></div> Generando análisis ejecutivo para el Decano...</div>';
  try {
    var res = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: {'Content-Type':'application/json','x-api-key':key,'anthropic-version':'2023-06-01','anthropic-dangerous-direct-browser-access':'true'},
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514', max_tokens: 1200,
        messages: [{role:'user', content:`Sos el asesor académico del Decano de la Facultad de Filosofía de la Universidad Católica de Cuyo (UCCuyo), Sede San Juan. Con datos verificados de mayo 2026, redactá un análisis ejecutivo para el Decanato.

CARRERAS: Lic. en Psicología (demanda alta, índice 122/100 vs 2019), Lic. en RRHH (creciendo, 121/100), Profesorado en Filosofía (estable-decreciente, 90/100), Maestría Evaluación Psicológica TCC (salud mental en auge), Maestría Gestión Tecnologías Comunicación (alta demanda digital), Doctorado Estudios Patrísticos (nicho único regional), Especialización Alta Gerencia Pública (moderada), Especialización Psicología Niñez y Adolescencia (alta).

ARANCELES MERCADO 2026: Psicología $480k–$750k/mes · RRHH $390k–$620k/mes · Filosofía $280k–$420k/mes · Maestrías $180k–$380k/mes · Especializaciones $150k–$300k/mes · Doctorado $160k–$280k/mes.

TENDENCIAS: Psicología y RRHH crecen sostenidamente. Humanidades: presión global -8% UNESCO 2024. Posgrados salud mental: crecimiento acelerado (déficit 1,18M OMS 2030). RRHH con IA: perfil más demandado WEF 2025. Comunicación digital: expansión global.

Formato: 6 bullets ejecutivos. Señalá con ⚠ las 2 alertas y con ★ las 3 oportunidades estratégicas. Un bullet de contexto. Sin preámbulo. Máximo 220 palabras. Lenguaje directo para el Decano.`}]
      })
    });
    var data = await res.json();
    if(data.error) throw new Error(data.error.message);
    var text = data.content ? data.content.map(function(b){ return b.text||''; }).join('') : '';
    var html = text.split('\n').filter(function(l){ return l.trim(); }).map(function(l){
      var t = l.trim();
      if(/^#{1,3}\s/.test(t) || /^\*\*[^*]+\*\*$/.test(t))
        return '<div style="font-size:11px;font-weight:700;color:#002856;margin:9px 0 3px;">'+t.replace(/^#+\s/,'').replace(/\*\*/g,'')+'</div>';
      if(/^[-•*]\s/.test(t) || /^[0-9]+\.\s/.test(t)){
        var body = t.replace(/^[-•*]\s/,'').replace(/^[0-9]+\.\s/,'').replace(/\*\*(.+?)\*\*/g,'<b>$1</b>');
        var isAlert = body.indexOf('⚠') >= 0;
        var isOpp   = body.indexOf('★') >= 0;
        var col  = isAlert ? '#b92b27' : isOpp ? '#1a7a4a' : '#5a6070';
        var mark = isAlert ? '⚠' : isOpp ? '★' : '▸';
        var bg   = isAlert ? 'background:#fdecea;padding:5px 8px;border-radius:6px;' : isOpp ? 'background:#e8f5ee;padding:5px 8px;border-radius:6px;' : '';
        return '<div style="display:flex;gap:7px;margin:5px 0;'+bg+'"><span style="color:'+col+';font-weight:700;flex-shrink:0;font-size:13px;">'+mark+'</span><span style="font-size:10px;line-height:1.55;">'+body+'</span></div>';
      }
      return '<div style="font-size:10px;margin:3px 0;line-height:1.5;">'+t.replace(/\*\*/g,'')+'</div>';
    }).join('');
    var now = new Date().toLocaleString('es-AR',{day:'2-digit',month:'long',year:'numeric'});
    zone.innerHTML = '<div class="ai-card"><div class="ai-ttl"><i class="ti ti-sparkles" style="color:#C8A04A;font-size:14px"></i> Análisis ejecutivo — Decanato Filosofía · '+now+'</div><div>'+html+'</div><div class="ai-disc">Generado por IA con datos verificados · Contrastar con estadísticas propias UCCuyo antes de tomar decisiones · Dashboard Facultad de Filosofía v1.1</div></div>';
  } catch(e) {
    zone.innerHTML = '<div class="ai-card"><div style="color:#b92b27;font-size:11px;">Error: '+e.message+'. Verificá que la API key sea válida.</div></div>';
  }
}

function updateTs(){
  var n = new Date();
  document.getElementById('upd-lbl').innerHTML = 'Última actualización<br>'+n.toLocaleString('es-AR',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'});
}
function setLoading(on){
  var btn = document.getElementById('rbtn');
  btn.disabled = on;
  btn.innerHTML = on ? '<span style="display:inline-block;width:11px;height:11px;border:2px solid rgba(0,40,86,.2);border-top-color:#002856;border-radius:50%;animation:spin .7s linear infinite;vertical-align:middle;margin-right:4px;"></span> Actualizando...' : '<i class="ti ti-refresh" style="font-size:11px"></i> Actualizar';
}
async function refreshAll(){
  setLoading(true);
  updateTs();
  await fetchAI();
  setLoading(false);
}

if(getKey()) document.getElementById('api-banner').style.display = 'none';
updateTs();
fetchAI();
setInterval(function(){ var n=new Date(); if(n.getHours()===8&&n.getMinutes()===0) refreshAll(); }, 60000);
</script>
